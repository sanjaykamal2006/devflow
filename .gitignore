# Root .gitignore

# Dependencies & Build Outputs
**/node_modules/
**/target/
**/.next/
**/build/
**/dist/
**/out/

# Environment Variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# IDE & Editor Files
.idea/
.vscode/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/

# Logs & Temp
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
Thumbs.db
*.tmp
*.bak

# Coverage & Test
**/coverage/
.nyc_output/
