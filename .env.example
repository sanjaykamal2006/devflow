# ==============================================================================
# DEVFLOW ENVIRONMENT CONFIGURATION
# Copy to .env and adjust values for your environment.
# Never commit .env with production credentials to version control.
# ==============================================================================

# Database (PostgreSQL)
POSTGRES_DB=devflow
POSTGRES_USER=devflow
POSTGRES_PASSWORD=devflow_secure_password_replace_in_prod
POSTGRES_PORT=5432

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Authentication (JWT)
# 256-bit or 512-bit hex/base64 encoded key
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# GitHub Integration (Optional - for higher rate limits and private repo testing)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
